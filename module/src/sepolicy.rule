type zygisk_file file_type
typeattribute zygisk_file mlstrustedobject
allow zygote zygisk_file sock_file {read write}

allow zygote magisk lnk_file read
allow zygote unlabeled file {read open}
allow zygote zygote capability sys_chroot
allow zygote su dir search
allow zygote su {lnk_file file} read

allow zygote adb_data_file dir {search getattr}
allow zygote adb_data_file file *
allow zygote proc file {read open}
allow zygote nsfs file {read open}
allow zygote zygote process {execmem ptrace}
allow system_server system_server process execmem
allow zygote tmpfs file *
allow zygote appdomain_tmpfs file *

allow init zygote_exec file *
allow init zygisk_file sock_file {read write}

allow init magisk lnk_file read
allow init unlabeled file {read open}
allow init init capability sys_chroot
allow init su dir search
allow init su {lnk_file file} read

allow init adb_data_file dir search
allow init adb_data_file file *
allow init proc file {read open}
allow init nsfs file {read open}
allow init init process execmem
allow init tmpfs file *
allow init appdomain_tmpfs file *
allow init zygote unix_stream_socket *
allow init zygote sock_file *
allow init magisk unix_dgram_socket *
